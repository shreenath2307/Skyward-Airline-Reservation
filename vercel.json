{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://skyward-airline-reservation-production.up.railway.app/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
